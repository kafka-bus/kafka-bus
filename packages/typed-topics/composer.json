{
    "name": "kafka-bus/typed-topics",
    "description": "Route multiple message types on one Apache Kafka topic using header-based factories and handlers for PHP",
    "type": "library",
    "keywords": [
        "php",
        "kafka",
        "apache-kafka",
        "kafka-bus",
        "typed-messages",
        "routing",
        "headers",
        "serialization"
    ],
    "homepage": "https://github.com/kafka-bus/typed-topics",
    "support": {
        "issues": "https://github.com/kafka-bus/kafka-bus/issues",
        "source": "https://github.com/kafka-bus/typed-topics",
        "docs": "https://github.com/kafka-bus/typed-topics#readme"
    },
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "kafka-bus/core": "^2.2",
        "psr/log": "^1.1|^2.0|^3.0"
    },
    "autoload": {
        "psr-4": {
            "KafkaBus\\TypedTopics\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "KafkaBus\\TypedTopics\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Kirill Popkov",
            "email": "kirill.popkov.work@gmail.com",
            "role": "Developer"
        }
    ]
}
