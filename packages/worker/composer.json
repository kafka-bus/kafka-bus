{
    "name": "kafka-bus/worker",
    "description": "Apache Kafka consumer workers for PHP with topic subscriptions, bus dispatch and synchronous offset commits",
    "type": "library",
    "keywords": [
        "php",
        "kafka",
        "apache-kafka",
        "kafka-bus",
        "consumer",
        "worker",
        "consumer-group",
        "offsets"
    ],
    "homepage": "https://github.com/kafka-bus/worker",
    "support": {
        "issues": "https://github.com/kafka-bus/kafka-bus/issues",
        "source": "https://github.com/kafka-bus/worker",
        "docs": "https://github.com/kafka-bus/worker#readme"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Kirill Popkov",
            "email": "kirill.popkov.work@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-rdkafka": "*",
        "kafka-bus/core": "^2.2"
    },
    "autoload": {
        "psr-4": {
            "KafkaBus\\Worker\\": "src/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
