{
    "name": "kafka-bus/messages",
    "description": "JSON messages, domain events and payload casters for PHP applications using Kafka Bus",
    "type": "library",
    "keywords": [
        "php",
        "kafka",
        "kafka-bus",
        "json",
        "messages",
        "domain-events",
        "serialization",
        "dto"
    ],
    "homepage": "https://github.com/kafka-bus/messages",
    "support": {
        "issues": "https://github.com/kafka-bus/kafka-bus/issues",
        "source": "https://github.com/kafka-bus/messages",
        "docs": "https://github.com/kafka-bus/messages#readme"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Kirill Popkov",
            "email": "kirill.popkov.work@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-rdkafka": "*",
        "kafka-bus/core": "^2.2",
        "webmozart/assert": "^1.11|^2.0"
    },
    "autoload": {
        "psr-4": {
            "KafkaBus\\Messages\\": "src/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
