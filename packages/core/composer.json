{
    "name": "kafka-bus/core",
    "description": "Apache Kafka messaging core for PHP with producer and consumer adapters, topic routing and middleware pipelines",
    "type": "library",
    "keywords": [
        "php",
        "kafka",
        "apache-kafka",
        "rdkafka",
        "message-bus",
        "producer",
        "consumer",
        "middleware"
    ],
    "homepage": "https://github.com/kafka-bus/core",
    "support": {
        "issues": "https://github.com/kafka-bus/kafka-bus/issues",
        "source": "https://github.com/kafka-bus/core",
        "docs": "https://github.com/kafka-bus/core#readme"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Kirill Popkov",
            "email": "kirill.popkov.work@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-rdkafka": "*",
        "psr/log": "^1.1|^2.0|^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "KafkaBus\\Core\\": "src/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true
        },
        "audit": {
            "abandoned": "report"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
