parameters:
    level: max

    paths:
        - examples/
        - benchmarks/
        - packages/core/src
        - packages/commiter/src
        - packages/messages/src
        - packages/worker/src
        - packages/metadata/src

    # Все пакеты видят vendor/ монорепо через path-repositories
    bootstrapFiles:
        - vendor/autoload.php

    stubFiles:
        - stubs/RdKafka.stub

    # Суммарный baseline — чтобы не захламлять per-package файлы
    # Генерируется: vendor/bin/phpstan analyse --generate-baseline
    ignoreErrors: []
