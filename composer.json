{
    "name": "micromus/kafka-bus-core",
    "description": "Monorepo for kafka-bus core packages",
    "license": "MIT",
    "authors": [
        {
            "name": "Kirill Popkov",
            "email": "kirill.popkov.work@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "kafka-bus/core": "*",
        "kafka-bus/commiter": "*",
        "kafka-bus/messages": "*"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24",
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpstan/extension-installer": "^1.3",
        "phpstan/phpstan": "^2.2",
        "symplify/monorepo-builder": "^11.2",
        "testo/assert": "^0.1.6",
        "testo/testo": "^0.10.17"
    },
    "repositories": [
        {"type": "path", "url": "packages/core"},
        {"type": "path", "url": "packages/commiter"},
        {"type": "path", "url": "packages/messages"}
    ],
    "autoload-dev": {
        "psr-4": {
            "KafkaBus\\Commiter\\Tests\\": "packages/commiter/tests/",
            "KafkaBus\\Messages\\Tests\\": "packages/messages/tests/",
            "KafkaBus\\Core\\Tests\\": "packages/core/tests/",
            "KafkaBus\\Workbench\\": "workbench/"
        }
    },
    "scripts": {
        "test": "vendor/bin/testo",
        "test-ci": "vendor/bin/testo",
        "analyse": "vendor/bin/phpstan analyse --configuration phpstan.neon",
        "format": "vendor/bin/php-cs-fixer fix --config .php-cs-fixer.php",
        "validate:monorepo":"vendor/bin/monorepo-builder validate",
        "release": "vendor/bin/monorepo-builder release"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true
        },
        "audit": {
            "abandoned": "report"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
