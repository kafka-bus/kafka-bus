{
    "name": "kafka-bus/kafka-bus",
    "description": "Kafka Bus: core, commiter, messages, worker and metadata in one package",
    "license": "MIT",
    "authors": [
        {
            "name": "Kirill Popkov",
            "email": "kirill.popkov.work@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-rdkafka": "*",
        "psr/log": "^1.1|^2.0|^3.0",
        "webmozart/assert": "^1.11|^2.0"
    },
    "replace": {
        "kafka-bus/commiter": "self.version",
        "kafka-bus/core": "self.version",
        "kafka-bus/messages": "self.version",
        "kafka-bus/metadata": "self.version",
        "kafka-bus/worker": "self.version"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24",
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpbench/phpbench": "^1.7",
        "phpstan/extension-installer": "^1.3",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^11.5",
        "symplify/monorepo-builder": "^11.2.23",
        "testo/assert": "^0.1.6",
        "testo/testo": "^0.10.23"
    },
    "autoload": {
        "psr-4": {
            "KafkaBus\\Core\\": "packages/core/src/",
            "KafkaBus\\Commiter\\": "packages/commiter/src/",
            "KafkaBus\\Messages\\": "packages/messages/src/",
            "KafkaBus\\Worker\\": "packages/worker/src/",
            "KafkaBus\\Metadata\\": "packages/metadata/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "KafkaBus\\Commiter\\Tests\\": "packages/commiter/tests/",
            "KafkaBus\\Messages\\Tests\\": "packages/messages/tests/",
            "KafkaBus\\Core\\Tests\\": "packages/core/tests/",
            "KafkaBus\\Worker\\Tests\\": "packages/worker/tests/",
            "KafkaBus\\Metadata\\Tests\\": "packages/metadata/tests/",
            "KafkaBus\\Workbench\\": "workbench/",
            "KafkaBus\\Benchmarks\\": "benchmarks/"
        }
    },
    "scripts": {
        "test": "vendor/bin/testo",
        "test-ci": "vendor/bin/testo",
        "analyse": "vendor/bin/phpstan analyse --configuration phpstan.neon",
        "format": "vendor/bin/php-cs-fixer fix --config .php-cs-fixer.php",
        "validate:monorepo": "vendor/bin/monorepo-builder validate",
        "bench": "vendor/bin/phpbench run --report=kafka-bus",
        "bench:docker": "docker compose -f benchmarks/compose.yml run --rm --build bench"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true
        },
        "audit": {
            "abandoned": "report"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
